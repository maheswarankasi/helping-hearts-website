rules_version = '2';

// Paste these into Firebase Console > Firestore Database > Rules > Publish.
//
// Your project starts in locked mode, so without these every read returns
// `permission-denied` and both the public pages and the admin panel come up
// empty.
//
// ============================================================================
// READ THIS BEFORE YOU GO LIVE
// ============================================================================
// The admin panel has no sign-in yet, so the rules below have to allow
// unauthenticated access for it to work at all. That is fine on localhost.
// It is NOT fine on a public URL, for two separate reasons:
//
//   1. WRITES ARE OPEN on shelters/events — anyone who knows your project id
//      could add or overwrite them.
//
//   2. PERSONAL DATA IS READABLE on volunteers/donors — these hold names,
//      email addresses, phone numbers, and donation amounts. Leaving read
//      open publishes them to anyone who asks. It would also contradict the
//      Privacy Policy on your own site, which promises this data is shared
//      only with staff who need it.
//
// Fix: add Firebase Auth sign-in to /admin, then replace every
// `allow read/write: if true` marked TODO below with
// `allow read, write: if request.auth != null;`
//
// Each block shows the locked-down version commented out, ready to swap in.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Public content, shown on the website ----------------------------

    match /shelters/{shelterId} {
      allow read: if true;
      allow write: if true; // TODO: change to `if request.auth != null`
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if true; // TODO: change to `if request.auth != null`
    }

    // ---- Form submissions containing personal data -----------------------
    // The public site only ever creates these; nothing on the public site
    // reads them back. Only the admin panel lists them.

    match /volunteers/{volunteerId} {
      allow create: if true;
      allow read: if true;   // TODO: change to `if request.auth != null`
      allow update, delete: if false;

      // Locked-down version, use once /admin has sign-in:
      // allow create: if true;
      // allow read, update, delete: if request.auth != null;
    }

    match /donors/{donorId} {
      allow create: if true;
      allow read: if true;   // TODO: change to `if request.auth != null`
      // The admin panel only ever reads donor records, so nothing needs to
      // modify or remove them.
      allow update, delete: if false;

      // Locked-down version, use once /admin has sign-in:
      // allow create: if true;
      // allow read: if request.auth != null;
      // allow update, delete: if false;
    }

    // Anything else stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
